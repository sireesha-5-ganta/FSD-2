<!DOCTYPE html>
<html>
<head>
    <title>Student Form</title>
</head>
<body>

    <h1>Student Registration</h1>

    <form action="/submit" method="POST">

        <label for="studentName">Student Name:</label>
        <input
            type="text"
            id="studentName"
            name="studentName"
            required
        >

        <br><br>

        <label for="email">Email:</label>
        <input
            type="email"
            id="email"
            name="email"
            required
        >

        <br><br>

        <button type="submit">Register</button>

    </form>

</body>
</html>