<!DOCTYPE html>
<html>
<head>
    <title>Week 8 - Stateful Application</title>
</head>

<body>
    <h1>Week 8 Stateful Application</h1>
    <% if (username) { %>
        <h2>Welcome, <%= username %>!</h2>
        <p>You are currently logged in.</p>
        <a href="/dashboard">Go to Dashboard</a>
        <br><br>
        <a href="/logout">Logout</a>

    <% } else { %>
        <h2>Welcome Guest!</h2>
        <a href="/login">Login</a>

    <% } %>

    <hr>
    <h2>Cookie Operations</h2>
    <a href="/set-cookie">Create Cookie</a>
    <br><br>
    <a href="/get-cookie">Read Cookie</a>
</body>
</html>